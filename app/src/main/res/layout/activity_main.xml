<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".MainActivity">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:id="@+id/Select"
        android:text="Select Unit Category"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:background="@android:color/transparent"
        android:textSize="20sp"
        />
    <Space
        android:layout_width="match_parent"
        android:id="@+id/space"
        android:layout_below="@+id/Select"
        android:background="@android:color/transparent"
        android:layout_height="24dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:layout_below="@+id/space">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:background="@android:color/transparent"
            android:columnOrderPreserved="false"
            android:useDefaultMargins="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:rowCount="5">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/length"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/white"
                app:cornerRadius="20dp"
                app:elevation="8dp"
                android:translationZ="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:stateListAnimator="@null"
                android:outlineProvider="background"
                android:clipToOutline="true"
                android:drawableTop="@drawable/length"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:gravity="center"
                android:text="Length"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/volume"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/white"
                app:cornerRadius="20dp"
                app:elevation="8dp"
                android:translationZ="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:stateListAnimator="@null"
                android:outlineProvider="background"
                android:clipToOutline="true"
                android:drawableTop="@drawable/volume"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:gravity="center"
                android:text="Volume"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/temp"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/white"
                app:cornerRadius="20dp"
                app:elevation="8dp"
                android:translationZ="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:stateListAnimator="@null"
                android:outlineProvider="background"
                android:clipToOutline="true"
                android:drawableTop="@drawable/temperature"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:gravity="center"
                android:text="Temperature"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/weight"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/white"
                app:cornerRadius="20dp"
                app:elevation="8dp"
                android:translationZ="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:stateListAnimator="@null"
                android:outlineProvider="background"
                android:clipToOutline="true"
                android:drawableTop="@drawable/weight"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:gravity="center"
                android:text="Weight"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/area"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/white"
                app:cornerRadius="20dp"
                app:elevation="8dp"
                android:translationZ="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:stateListAnimator="@null"
                android:outlineProvider="background"
                android:clipToOutline="true"
                android:drawableTop="@drawable/area"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:gravity="center"
                android:text="Area"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/speed"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/white"
                app:cornerRadius="20dp"
                app:elevation="8dp"
                android:translationZ="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:stateListAnimator="@null"
                android:outlineProvider="background"
                android:clipToOutline="true"
                android:drawableTop="@drawable/speed"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:gravity="center"
                android:text="Speed"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/time"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/white"
                app:cornerRadius="20dp"
                app:elevation="8dp"
                android:translationZ="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:stateListAnimator="@null"
                android:outlineProvider="background"
                android:clipToOutline="true"
                android:drawableTop="@drawable/time"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:gravity="center"
                android:text="Time"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pressure"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/white"
                app:cornerRadius="20dp"
                app:elevation="8dp"
                android:translationZ="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:stateListAnimator="@null"
                android:outlineProvider="background"
                android:clipToOutline="true"
                android:drawableTop="@drawable/pressure"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:gravity="center"
                android:text="Pressure"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/energy"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/white"
                app:cornerRadius="20dp"
                app:elevation="8dp"
                android:translationZ="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:stateListAnimator="@null"
                android:outlineProvider="background"
                android:clipToOutline="true"
                android:drawableTop="@drawable/energy"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:gravity="center"
                android:text="Energy"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/data"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/white"
                app:cornerRadius="20dp"
                app:elevation="8dp"
                android:translationZ="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:stateListAnimator="@null"
                android:outlineProvider="background"
                android:clipToOutline="true"
                android:drawableTop="@drawable/data"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:gravity="center"
                android:text="Data Storage"
                android:textColor="@color/black"
                android:textSize="18sp" />


        </GridLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="25dp"/>


    </LinearLayout>
    </ScrollView>
</RelativeLayout>