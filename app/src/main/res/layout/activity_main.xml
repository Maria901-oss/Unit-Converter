<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="60dp"
    tools:context=".MainActivity">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/Select"
        android:text="Select Unit Category"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:padding="20dp"
        android:textSize="20sp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/Select">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:columnOrderPreserved="false"
            android:padding="8dp"
            android:rowCount="5">

            <Button
                android:id="@+id/length"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:paddingTop="24dp"
                android:background="@drawable/button"
                android:text="Length"
                android:drawableTop="@drawable/length"
                android:gravity="center"
                android:textSize="18sp" />

            <Button
                android:id="@+id/volume"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:paddingTop="24dp"
                android:drawablePadding="2dp"
                android:background="@drawable/button"
                android:text="Volume"
                android:drawableTop="@drawable/volume"
                android:gravity="center"
                android:textSize="18sp" />

            <Button
                android:id="@+id/temp"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:paddingTop="24dp"
                android:background="@drawable/button"
                android:text="Temperature"
                android:drawableTop="@drawable/temprature"
                android:gravity="center"
                android:textSize="18sp" />

            <Button
                android:id="@+id/weight"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:paddingTop="24dp"
                android:background="@drawable/button"
                android:text="Weight"
                android:drawableTop="@drawable/weight"
                android:gravity="center"
                android:textSize="18sp" />

            <Button
                android:id="@+id/area"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:paddingTop="24dp"
                android:background="@drawable/button"
                android:text="Area"
                android:drawableTop="@drawable/area"
                android:gravity="center"
                android:textSize="18sp" />

            <Button
                android:id="@+id/speed"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:paddingTop="24dp"
                android:background="@drawable/button"
                android:text="Speed"
                android:drawableTop="@drawable/speed"
                android:gravity="center"
                android:textSize="18sp" />

            <Button
                android:id="@+id/time"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:paddingTop="24dp"
                android:background="@drawable/button"
                android:text="Time"
                android:drawableTop="@drawable/time"
                android:gravity="center"
                android:textSize="18sp" />

            <Button
                android:id="@+id/pressure"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:paddingTop="24dp"
                android:background="@drawable/button"
                android:text="Pressure"
                android:drawableTop="@drawable/pressure"
                android:gravity="center"
                android:textSize="18sp" />

            <Button
                android:id="@+id/energy"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:paddingTop="24dp"
                android:background="@drawable/button"
                android:text="Energy"
                android:drawableTop="@drawable/energy"
                android:gravity="center"
                android:textSize="18sp" />

            <Button
                android:id="@+id/data"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:paddingTop="24dp"
                android:background="@drawable/button"
                android:text="Data Storage"
                android:drawableTop="@drawable/data"
                android:gravity="center"
                android:textSize="18sp" />


        </GridLayout>


    </LinearLayout>
    </ScrollView>
</RelativeLayout>