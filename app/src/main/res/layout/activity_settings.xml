<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/white"
    tools:context=".settings">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ic_launcher_background"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:elevation="4dp">

            <!-- App Theme -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Theme"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:paddingBottom="12dp"/>

            <RadioGroup
                android:id="@+id/themeRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:divider="@drawable/ic_launcher_foreground">

                <RadioButton
                    android:id="@+id/themeDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default"
                    android:textColor="@color/black"/>

                <RadioButton
                    android:id="@+id/themeLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Light"
                    android:textColor="@color/black"/>

                <RadioButton
                    android:id="@+id/themeDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dark"
                    android:textColor="@color/black"/>
            </RadioGroup>

            <!-- Number Format -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Number Format"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:paddingTop="16dp"
                android:paddingBottom="12dp"/>

            <RadioGroup
                android:id="@+id/numberFormatRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/formatGeneral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General Decimal"
                    android:textColor="@color/black"/>

                <RadioButton
                    android:id="@+id/formatThousands"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thousands Separator"
                    android:textColor="@color/black"/>

                <RadioButton
                    android:id="@+id/formatScientific"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scientific"
                    android:textColor="@color/black"/>
            </RadioGroup>

            <!-- Decimal Places -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Decimal Places (0 to 10)"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:paddingTop="16dp"
                android:paddingBottom="12dp"/>

            <SeekBar
                android:id="@+id/decimalSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10"
                android:progress="2"
                android:thumbTint="@color/teal_primary"
                android:progressTint="@color/teal_primary"/>

            <TextView
                android:id="@+id/decimalValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:paddingTop="4dp"/>
        </LinearLayout>

</ScrollView>