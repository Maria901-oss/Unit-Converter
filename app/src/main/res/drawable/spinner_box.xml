<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_main"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#D1D5DB"/>
            <padding android:left="12dp" android:top="12dp" android:right="0dp" android:bottom="12dp"/>
        </shape>
    </item>

    <item
        android:drawable="@drawable/outline_arrow_drop_down_24"
        android:width="20dp"
        android:height="20dp"
        android:gravity="right|center_vertical"
        android:right="12dp"
        />

</layer-list>
